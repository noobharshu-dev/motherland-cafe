# Database connection string (PostgreSQL via Neon, Supabase, etc.)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Resend API Key for sending emails (reservations, contact form)
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="reservations@yourdomain.com"
RESEND_TO_EMAIL="admin@yourdomain.com"

# The public URL of your site (used for SEO and canonical links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin Panel credentials
# Make sure to change this in production!
ADMIN_PASSWORD="your_secure_password"

# Cloudinary credentials for image uploads
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Upstash Redis credentials for Rate Limiting (optional but recommended in production)
UPSTASH_REDIS_REST_URL="https://your-upstash-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_token"
